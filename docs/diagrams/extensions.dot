  modules [label="HOUSE CAT MODULES\nWhiskers • Library • Lab • Missions", fillcolor="#E56B5D", fontcolor="white"];
  registry [label="CAPABILITY REGISTRY\nWhat can I do right now?", fillcolor="#D9A441"];
